# Database — lokalna (Docker) ili Supabase / bilo koji PostgreSQL
# Lokalno (nakon docker compose up -d):
DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleet?schema=public"
# Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# NextAuth (v5 koristi AUTH_SECRET ili NEXTAUTH_SECRET)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_SECRET="..."  # alternativno za NextAuth v5

# Optional: Supabase for storage (documents)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ============================================================
# Email / SMTP (za automatske alarm notifikacije)
# Bez ovih varijabli email se ne šalje, aplikacija radi normalno.
# ============================================================

# SMTP server (primeri)
# Gmail (App Password):  smtp.gmail.com, port 587
# Brevo (bivši SendGrid): smtp-relay.brevo.com, port 587
# Mailtrap (test):        sandbox.smtp.mailtrap.io, port 587

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="vas-email@gmail.com"
SMTP_PASS="app-password-ili-api-key"
SMTP_FROM="Fleet Status <vas-email@gmail.com>"

# Naziv aplikacije koji se prikazuje u emailovima
APP_NAME="Fleet Status Manager"

# Primaoci email notifikacija (admin emailovi, razdvojeni zarezom).
# Ako nije postavljeno, koriste se email adrese SUPER_ADMIN i FLEET_ADMIN korisnika iz baze.
# ALERT_EMAIL_RECIPIENTS="admin@firma.rs,voznipark@firma.rs"

# Cron tajni ključ za zaštitu /api/alerts/generate endpoint-a
# Generiši sa: openssl rand -hex 32
# CRON_SECRET="..."
