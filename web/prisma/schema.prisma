// Fleet Status Manager - Multi-tenant schema
// PRD: https://github.com/... (see repo root PRD.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============== Multi-tenant & Auth ==============
model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  alertEmailRecipients String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users             User[]
  drivers           Driver[]
  vehicles          Vehicle[]
  travelOrders      TravelOrder[]
  alertRules        AlertRule[]
  auditLogs         AuditLog[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, FLEET_ADMIN, DISPATCHER, DRIVER, VIEWER
  description String?
  createdAt   DateTime @default(now())

  users User[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String?
  image          String?
  roleId         String
  organizationId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  role         Role         @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============== Drivers ==============
model Driver {
  id                   String    @id @default(cuid())
  organizationId       String
  externalId           String?   // JMBG or internal ID
  firstName            String
  lastName             String
  phone                String?
  email                String?
  address              String?
  jobTitle             String?
  employmentStartDate  DateTime?
  employmentStatus     String   @default("active") // active, inactive, terminated
  licenseNumber        String?
  licenseCategories    String?   // e.g. "B,C"
  licenseExpiry        DateTime?
  idCardNumber         String?
  idCardExpiry         DateTime?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents       DriverDocument[]
  assignments     DriverAssignment[]
  travelOrders   TravelOrder[]
  alerts         Alert[]
}

model DriverDocument {
  id          String   @id @default(cuid())
  driverId    String
  type        String   // license, id_card, other
  documentNumber String?
  validFrom   DateTime?
  validTo     DateTime?
  filePath    String?  // optional attachment
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

// ============== Vehicles ==============
model Vehicle {
  id                 String    @id @default(cuid())
  organizationId     String
  registrationNumber String
  vin                String?
  make               String
  model              String
  year               Int
  fuelType           String?
  engineDisplacement Int?      // cm3
  powerKw            Int?
  firstRegistration  DateTime?
  status             String   @default("active") // active, inactive, in_service, sold
  purchaseDate       DateTime?
  purchasePrice      Decimal?  @db.Decimal(12, 2)
  currentValue       Decimal?  @db.Decimal(12, 2)
  acquisitionType    String?   // purchase, leasing
  leasingCompany     String?
  leasingContractNo  String?
  leasingStart       DateTime?
  leasingEnd         DateTime?
  leasingMonthly     Decimal?  @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      VehicleDocument[]
  fuelEntries    FuelEntry[]
  assignments    DriverAssignment[]
  serviceRecords ServiceRecord[]
  travelOrders   TravelOrder[]
  gpsDevice      GpsDevice?
  alerts         Alert[]
}

model VehicleDocument {
  id             String    @id @default(cuid())
  vehicleId      String
  type           String   // registration, insurance, green_card, yellow_card, lpg_cert, other
  documentNumber String?
  validFrom      DateTime?
  validTo        DateTime?
  filePath       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ============== Fuel & Mileage ==============
model FuelEntry {
  id              String   @id @default(cuid())
  vehicleId       String
  date            DateTime
  odometerKm      Int
  odometerDeltaKm Int?     // km since last entry
  fuelLiters      Decimal? @db.Decimal(10, 2)
  pricePerLiter   Decimal? @db.Decimal(10, 4)
  totalAmount     Decimal? @db.Decimal(12, 2)
  location        String?
  fuelType        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ============== Driver Assignments (zaduženja) ==============
model DriverAssignment {
  id            String    @id @default(cuid())
  driverId      String
  vehicleId     String?
  type          String   // vehicle, keys, fuel_card, gps_device, docs, phone, equipment
  assignedAt    DateTime @default(now())
  returnedAt    DateTime?
  status        String   @default("active") // active, returned
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
}

// ============== Travel Orders ==============
model TravelOrder {
  id              String   @id @default(cuid())
  organizationId  String
  orderNumber     String
  driverId        String
  vehicleId       String
  route           String?
  purpose         String?
  departureAt     DateTime?
  returnAt        DateTime?
  startOdometer   Int?
  endOdometer     Int?
  distanceKm      Int?
  fuelUsed        Decimal? @db.Decimal(10, 2)
  status          String   @default("draft") // draft, approved, completed, cancelled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  expenses     TravelOrderExpense[]
}

model TravelOrderExpense {
  id             String   @id @default(cuid())
  travelOrderId  String
  description    String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("RSD")
  createdAt      DateTime @default(now())

  travelOrder TravelOrder @relation(fields: [travelOrderId], references: [id], onDelete: Cascade)
}

// ============== Services ==============
model ServiceRecord {
  id                String   @id @default(cuid())
  vehicleId         String
  type              String   // routine, repair, preventive
  sentAt            DateTime?
  completedAt       DateTime?
  description       String?
  workshop          String?
  invoiceAmount     Decimal? @db.Decimal(12, 2)
  invoiceNumber     String?
  filePath          String?
  nextServiceKm     Int?
  nextServiceDate   DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ============== Alerts ==============
model AlertRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String   // document_expiry, service_due, etc.
  warningDays    Int      @default(30)
  criticalDays   Int      @default(5)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Alert {
  id             String    @id @default(cuid())
  vehicleId      String?
  driverId       String?
  type           String
  level          String    // warning, critical, expired
  title          String
  message        String?
  entityType     String?   // vehicle, driver, document, service
  entityId       String?
  status         String    @default("active") // active, resolved, ignored
  resolvedAt     DateTime?
  resolvedBy     String?
  emailSentAt    DateTime? // when the last email notification was sent
  emailSentLevel String?   // level at which the last email was sent
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

// ============== GPS (MVP: device id only) ==============
model GpsDevice {
  id         String   @id @default(cuid())
  vehicleId  String   @unique
  externalId String   // ID from GPS provider
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ============== Audit ==============
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
